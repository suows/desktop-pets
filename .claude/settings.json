{
  "mcpServers": {},
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(*)",
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "WebFetch",
      "WebSearch",
      "TaskOutput",
      "TaskStop",
      "SendMessage"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd /d/PROGRAMS/desktop-pets && echo \"- $(date +%Y-%m-%d): [自动记录] 会话结束，Stop hook 触发\" >> .claude/memory/development-progress.md 2>/dev/null; echo '{\"systemMessage\": \"Stop hook: 记忆文件时间戳已记录\"}'",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  }
}
